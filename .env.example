# Persistencia
APP_MODE=demo
PROMPT_PROFILE=baseline
BEHAVIOR_POLICY=moves_v1
DATABASE_PATH=data/nora_quantica.db
STORAGE_BACKEND=sqlite
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION_PREFIX=nora
CONVERSATION_RETENTION_HOURS=48

# Protección antiabuso
RATE_LIMIT_ENABLED=false
CONVERSATIONS_PER_HOUR=3
CONVERSATIONS_PER_IP_DAY=10
MESSAGES_PER_MINUTE=12
MESSAGES_PER_IP_DAY=120
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
LAB_DETAIL_LEVEL=full
SESSION_EXPORT_ENABLED=true

# Ensayos controlados (dejar vacíos para usar ANU normalmente)
EXPERIMENT_INITIAL_BYTES_HEX=
EXPERIMENT_BEHAVIOR_SEED_ID=

# ANU Quantum Numbers: https://quantumnumbers.anu.edu.au/
ANU_QRNG_API_KEY=
ANU_QRNG_URL=https://api.quantumnumbers.anu.edu.au

# Valores compartidos opcionales para APIs compatibles con OpenAI
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Evaluador descriptivo
EVALUATOR_PROVIDER=openai_compatible
EVALUATOR_MODEL=gpt-4.1-mini
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=https://api.openai.com/v1
EVALUATOR_TEMPERATURE=0

# Generador conversacional
GENERATOR_PROVIDER=openai_compatible
GENERATOR_MODEL=gpt-4.1-mini
GENERATOR_API_KEY=
GENERATOR_BASE_URL=https://api.openai.com/v1
GENERATOR_TEMPERATURE=0.35

HISTORY_LIMIT=24
MAX_TURNS_PER_CONVERSATION=24
